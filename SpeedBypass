    end
    PCPowerInput.Text = tostring(Config.PCPower)
    PCFooter.Text = "v2 • " .. tostring(Config.PCPower) .. " power • Licensed"
    SaveConfig()
    if running and currentMode == "PC" then restartSpamLoop() end
end)

MobilePowerInput.FocusLost:Connect(function()
