        Config.MobilePower = math.clamp(num, 10000, 100000)
    else
        Config.MobilePower = 72000
    end
    MobilePowerInput.Text = tostring(Config.MobilePower)
    MobileFooter.Text = "v2 • " .. tostring(Config.MobilePower) .. " power • Licensed"
