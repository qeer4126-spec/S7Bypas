-- ===== UI HELPERS =====
local function createNotification(title, message, iconColor, duration)
    local sg = Instance.new("ScreenGui")
    sg.Name = "S7Notification"
    sg.ResetOnSpawn = false
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    
    pcall(function() sg.Parent = game:GetService("CoreGui") end)
    if not sg.Parent then 
        sg.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui") 
    end

    local frame = Instance.new("Frame", sg)
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    frame.Position = UDim2.new(0.5, 0, 0.5, 0)
    frame.Size = UDim2.new(0, 340, 0, 150)
    frame.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
    frame.BackgroundTransparency = 0.05
    frame.BorderSizePixel = 0

    local corner = Instance.new("UICorner", frame)
    corner.CornerRadius = UDim.new(0, 20)

    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = iconColor
    stroke.Thickness = 2
    stroke.Transparency = 0.2

    local icon = Instance.new("TextLabel", frame)
    icon.Size = UDim2.new(0, 50, 0, 50)
    icon.Position = UDim2.new(0.5, -25, 0, 20)
    icon.BackgroundTransparency = 1
    icon.Font = Enum.Font.GothamBold
    icon.Text = title == "Загрузка..." and "🔐" or (title == "Успех!" and "✓" or "❌")
    icon.TextColor3 = iconColor
    icon.TextSize = title == "Успех!" and 40 or 36

    local titleLabel = Instance.new("TextLabel", frame)
    titleLabel.Size = UDim2.new(1, -20, 0, 30)
    titleLabel.Position = UDim2.new(0, 10, 0, 75)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.Text = title
    titleLabel.TextColor3 = Color3.fromRGB(240, 240, 245)
    titleLabel.TextSize = 16

    local msgLabel = Instance.new("TextLabel", frame)
    msgLabel.Size = UDim2.new(1, -30, 0, 50)
    msgLabel.Position = UDim2.new(0, 15, 0, 100)
    msgLabel.BackgroundTransparency = 1
    msgLabel.Font = Enum.Font.Gotham
    msgLabel.Text = message
    msgLabel.TextColor3 = Color3.fromRGB(160, 160, 170)
    msgLabel.TextSize = 12
    msgLabel.TextWrapped = true

    frame.Size = UDim2.new(0, 0, 0, 0)
    game:GetService("TweenService"):Create(frame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 340, 0, 150)
    }):Play()

    task.delay(duration or 4, function()
        game:GetService("TweenService"):Create(frame, TweenInfo.new(0.3), {
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1
        }):Play()
        task.wait(0.4)
        sg:Destroy()
    end)

    return msgLabel
end

-- ===== KEY VALIDATION =====
if not inputKey or inputKey == "" then
    createNotification("Ошибка доступа!", "Ключ не указан!\nИспользуйте: getgenv().S7BypassKey = \"ВАШИ_КЛЮЧ\"", Color3.fromRGB(220, 70, 70), 6)
    return
end

local loadingMsg = createNotification("Загрузка...", "Проверка ключа в базе данных...", Color3.fromRGB(80, 120, 255), 999)

-- API запрос к JSONBin
local success, response = pcall(function()
    return game:HttpGetAsync(API_URL)
end)

if not success then
    loadingMsg.Parent.Parent:Destroy()
    createNotification("Ошибка сети!", "Не удалось подключиться к серверу ключей.\nПроверьте интернет соединение.", Color3.fromRGB(220, 70, 70), 6)
    warn("[S7] Network error:", response)
    return
end

-- Парсинг JSON
local data
success, data = pcall(function()
    return HttpService:JSONDecode(response)
end)

if not success or not data then
    loadingMsg.Parent.Parent:Destroy()
    createNotification("Ошибка данных!", "Не удалось обработать ответ сервера.\nПопробуйте позже.", Color3.fromRGB(220, 70, 70), 6)
    warn("[S7] JSON parse error:", data)
    return
end

-- DEBUG: Выводим полученную структуру
warn("[S7] Full response structure:", HttpService:JSONEncode(data))

-- Получаем список ключей - пробуем разные пути
local keysList = nil

if data.record and data.record.keys then
    keysList = data.record.keys
    warn("[S7] Found keys in data.record.keys")
elseif data.keys then
    keysList = data.keys
    warn("[S7] Found keys in data.keys")
else
    warn("[S7] No keys found in response!")
end

-- Проверяем что ключи есть
if not keysList or type(keysList) ~= "table" then
    loadingMsg.Parent.Parent:Destroy()
    createNotification("Ошибка структуры!", "Неправильная структура базы данных.\nОбратитесь к администратору.", Color3.fromRGB(220, 70, 70), 6)
    warn("[S7] Invalid keysList:", keysList)
    return
end

warn("[S7] Keys list type:", type(keysList))
warn("[S7] Keys list content:", HttpService:JSONEncode(keysList))

-- Проверяем ключ в списке
local validKey = false

-- Проверяем если это массив ключей
if #keysList > 0 then
    warn("[S7] Checking array format with", #keysList, "keys")
    for i, key in ipairs(keysList) do
        warn("[S7] Comparing array key", i .. ":", key, "with input:", inputKey)
        if tostring(key) == tostring(inputKey) then
            validKey = true
            warn("[S7] KEY MATCH FOUND IN ARRAY!")
            break
        end
    end
else
    -- Проверяем если это объект с ключами
    warn("[S7] Checking object format")
    for key, value in pairs(keysList) do
        warn("[S7] Comparing object key:", key, "with input:", inputKey)
        if tostring(key) == tostring(inputKey) then
            -- Проверяем активность если есть
            if type(value) == "table" and value.active == false then
                warn("[S7] Key found but inactive")
                validKey = false
            else
                validKey = true
                warn("[S7] KEY MATCH FOUND IN OBJECT!")
            end
            break
        end
    end
end

loadingMsg.Parent.Parent:Destroy()

warn("[S7] Final validation result:", validKey)

if not validKey then
    createNotification("Доступ запрещен!", "Ключ '" .. tostring(inputKey) .. "' не найден в базе данных.\nПроверьте правильность ключа.", Color3.fromRGB(220, 70, 70), 8)
    return
end

