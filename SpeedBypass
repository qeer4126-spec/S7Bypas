        else
            Tween(MobileToggleBtn, {BackgroundColor3 = Color3.fromRGB(30, 30, 35), TextColor3 = Color3.fromRGB(140, 140, 150)})
            Tween(MobileToggleBtnStroke, {Color = Color3.fromRGB(60, 60, 65), Transparency = 0.8})
            Tween(MobileToggleStroke, {Color = Color3.fromRGB(60, 60, 65), Transparency = 0.7})
            Tween(BorderStroke, {Color = Color3.fromRGB(80, 80, 85), Transparency = 0.7})
            Tween(ModeStroke, {Color = Color3.fromRGB(60, 60, 65), Transparency = 0.5})
            MobileToggleBtn.Text = "OFF"
        end
    end
end

local function ToggleBypass()
    running = not running
    updateToggleVisuals(running)
    if running then
        NetworkClient:SetOutgoingKBPSLimit(math.huge)
        restartSpamLoop()
    else
        if spamThread then task.cancel(spamThread) end
        bomb = nil
        NetworkClient:SetOutgoingKBPSLimit(0)
    end
end

local function SwitchMode()
    if running then
        running = false
        if spamThread then task.cancel(spamThread) end
        bomb = nil
        NetworkClient:SetOutgoingKBPSLimit(0)
        updateToggleVisuals(false)
    end
    
    currentMode = currentMode == "PC" and "Mobile" or "PC"
    Config.Mode = currentMode
    
    PCElements.Visible = currentMode == "PC"
    MobileElements.Visible = currentMode == "Mobile"
    
    if currentMode == "PC" then
        ModeSwitchBtn.Text = "PC"
        PCFooter.Text = "v2 • " .. tostring(Config.PCPower) .. " power • Licensed"
    else
        ModeSwitchBtn.Text = "Mobile"
        MobileFooter.Text = "v2 • " .. tostring(Config.MobilePower) .. " power • Licensed"
    end
    
    SaveConfig()
    updateCanvas()
end

PCToggleBtn.MouseButton1Click:Connect(ToggleBypass)
MobileToggleBtn.MouseButton1Click:Connect(ToggleBypass)
ModeSwitchBtn.MouseButton1Click:Connect(SwitchMode)

local function addHoverEffect(button)
    button.MouseEnter:Connect(function()
        if not running then
            Tween(button, {BackgroundTransparency = 0.05}, 0.2)
        end
    end)
    button.MouseLeave:Connect(function()
        if not running then
            Tween(button, {BackgroundTransparency = 0.2}, 0.2)
        end
    end)
end

addHoverEffect(PCToggleBtn)
addHoverEffect(MobileToggleBtn)
addHoverEffect(ModeSwitchBtn)

PCPowerInput.FocusLost:Connect(function()
